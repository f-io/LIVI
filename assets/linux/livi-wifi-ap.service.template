# LIVI systemd unit. Managed by LIVI. Do not edit by hand.
# Single source of truth for livi-core and the installer.
[Unit]
Description=LIVI wireless projection AP (early boot)
After=network.target
ConditionPathExists=/usr/local/sbin/livi-helperd

[Service]
Type=simple
Environment=SUDO_USER=__USERNAME__
ExecStartPre=/usr/local/sbin/livi-helperd --wifi-ap-claim
ExecStart=/usr/local/sbin/livi-helperd --wifi-ap
ExecStop=/usr/local/sbin/livi-helperd --wifi-ap-teardown
TimeoutStopSec=8
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
