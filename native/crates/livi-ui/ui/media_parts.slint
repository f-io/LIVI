import { Theme } from "theme.slint";
import { Focus } from "focus.slint";

export enum MediaSource { phone, dab, fm }

export global MediaText {
    in property <string> phone-source: "Phone";
    in property <string> dab-source: "DAB+";
    in property <string> fm-source: "FM";
    in property <string> no-stations: "No stations yet";
    in property <string> no-fm-stations: "No stations yet";
    in property <string> no-artwork: "No Artwork";
}

export global Press {
    in property <bool> play;
    in property <bool> next;
    in property <bool> prev;
}

export component RoundButton inherits Rectangle {
    in property <bool> focused;
    in property <bool> flash;
    in property <bool> pressed;
    in property <bool> enabled: true;
    in property <length> size;
    in property <length> icon-size;
    in property <image> icon;
    in property <color> icon-color: Theme.text;
    callback clicked();

    property <bool> down: touch.pressed || root.flash || root.pressed;
    property <bool> hover: touch.has-hover && root.enabled;

    width: size;
    height: size;
    opacity: enabled ? 1 : 0.4;
    Rectangle {
        property <float> s: root.down && !root.focused ? 0.94 : 1;
        width: root.size * s;
        height: root.size * s;
        border-radius: self.width / 2;
        background: root.hover || root.down || root.focused ? Theme.button-active : Theme.button;
        animate width, height { duration: 110ms; easing: ease; }
        Rectangle {
            border-radius: parent.width / 2;
            border-width: root.focused ? 3px : root.down ? 4px : root.hover ? 2px : 0;
            border-color: Theme.primary;
        }
        Image {
            width: root.icon-size;
            height: root.icon-size;
            source: root.icon;
            colorize: root.icon-color;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Spectrum inherits Rectangle {
    in property <[float]> bands;

    property <float> spec-w: root.width / 1px;
    property <float> font: min(16, floor(spec-w / 12));
    property <bool> labels: font >= 9;
    property <length> usable-h: round((root.height - (labels ? (font + 4) * 1px : 0)) / 1phx) * 1phx;
    property <length> bar-w: root.width / 24;
    property <float> char-w: font * 0.56;
    property <float> gap: font * 0.5;
    property <bool> show-10k: spec-w * 0.1 >= char-w * 1.5 + char-w * 3 + gap;

    pure function at(freq: float) -> float {
        return (log(freq, 10) - log(20, 10)) / (log(20000, 10) - log(20, 10));
    }

    for b[i] in root.bands: Rectangle {
        x: i * root.bar-w;
        y: root.usable-h - self.height;
        width: root.bar-w * 0.8;
        height: round(root.usable-h * b / 1phx) * 1phx;
        background: Theme.highlight;
    }
    if root.labels: Text {
        x: 0;
        y: root.usable-h + 2px;
        text: "20";
        font-size: root.font * 1px;
        color: Theme.text-secondary.with-alpha(0.9);
    }
    if root.labels: Text {
        x: root.width * root.at(100) - self.width / 2;
        y: root.usable-h + 2px;
        text: "100";
        font-size: root.font * 1px;
        color: Theme.text-secondary.with-alpha(0.9);
    }
    if root.labels: Text {
        x: root.width * root.at(1000) - self.width / 2;
        y: root.usable-h + 2px;
        text: "1k";
        font-size: root.font * 1px;
        color: Theme.text-secondary.with-alpha(0.9);
    }
    if root.labels && root.show-10k: Text {
        x: root.width * root.at(10000) - self.width / 2;
        y: root.usable-h + 2px;
        text: "10k";
        font-size: root.font * 1px;
        color: Theme.text-secondary.with-alpha(0.9);
    }
    if root.labels: Text {
        x: root.width - self.width;
        y: root.usable-h + 2px;
        text: "20k";
        font-size: root.font * 1px;
        color: Theme.text-secondary.with-alpha(0.9);
    }
}

component SourceTab inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> focused;
    in property <float> pad: 1;
    in property <float> font: 1;
    callback picked();
    height: label-text.preferred-height + 12px * root.pad;
    width: label-text.preferred-width + 40px * root.pad;
    border-radius: self.height / 2;
    border-width: root.focused ? 3px : 0;
    border-color: Theme.primary;
    label-text := Text {
        text: root.label;
        font-size: 16px * root.font;
        font-weight: 700;
        color: root.on ? Theme.primary : Theme.text;
        opacity: root.on ? 1 : 0.65;
    }
    TouchArea {
        clicked => {
            if (!root.on) {
                root.picked();
            }
        }
    }
}

component TabDivider inherits Rectangle {
    in property <float> pad: 1;
    width: 1px;
    VerticalLayout {
        padding-top: 6px * root.pad;
        padding-bottom: 6px * root.pad;
        Rectangle { background: Theme.divider; }
    }
}

export component SourceTabs inherits Rectangle {
    in property <MediaSource> view;
    in property <int> focus-base;
    in property <length> room: 100000px;
    callback phone();
    callback dab();
    callback fm();
    property <length> text-w: phone-w.preferred-width + dab-w.preferred-width + fm-w.preferred-width;
    property <length> gaps: 3 * 40px + 4 * 8px + 16px;
    property <float> pad: max(0.25, min(1, (root.room - root.text-w - 2px) / root.gaps));
    property <float> font: max(0.6, min(1, (root.room - 2px - root.gaps * root.pad) / root.text-w));
    width: pill.width;
    height: pill.height;
    pill := Rectangle {
        width: row.preferred-width;
        height: row.preferred-height;
        border-radius: self.height / 2;
        background: Theme.dark ? #ffffff14 : #00000012;
        row := HorizontalLayout {
            padding-left: 8px * root.pad;
            padding-right: 8px * root.pad;
            padding-top: 4px * root.pad;
            padding-bottom: 4px * root.pad;
            spacing: 8px * root.pad;
            SourceTab {
                label: MediaText.phone-source;
                pad: root.pad;
                font: root.font;
                on: root.view == MediaSource.phone;
                focused: Focus.main(root.focus-base);
                picked => { root.phone(); }
            }
            TabDivider { pad: root.pad; }
            SourceTab {
                label: MediaText.dab-source;
                pad: root.pad;
                font: root.font;
                on: root.view == MediaSource.dab;
                focused: Focus.main(root.focus-base + 1);
                picked => { root.dab(); }
            }
            TabDivider { pad: root.pad; }
            SourceTab {
                label: MediaText.fm-source;
                pad: root.pad;
                font: root.font;
                on: root.view == MediaSource.fm;
                focused: Focus.main(root.focus-base + 2);
                picked => { root.fm(); }
            }
        }
    }
    phone-w := Text { visible: false; text: MediaText.phone-source; font-size: 16px; font-weight: 700; }
    dab-w := Text { visible: false; text: MediaText.dab-source; font-size: 16px; font-weight: 700; }
    fm-w := Text { visible: false; text: MediaText.fm-source; font-size: 16px; font-weight: 700; }
}

export component MediaGeometry {
    in property <float> w;
    in property <float> h;

    pure function clampf(v: float, lo: float, hi: float) -> float { return min(max(v, lo), hi); }

    property <float> min-side: min(w, h);
    property <float> page-pad-raw: round(clampf(min-side * 0.02, 12, 22));
    property <float> progress-h-raw: round(clampf(h * 0.012, 8, 12));
    property <float> art-allowance: max(140, floor(inner-w - 120 - col-gap));

    out property <bool> tiny: h > 0 && h <= 320;
    out property <float> text-scale: tiny ? 0.88 : 1;
    out property <float> page-pad: tiny ? min(page-pad-raw, 10) : page-pad-raw;
    out property <float> bottom-pad: tiny ? 2 : page-pad;
    out property <float> col-gap: round(clampf(w * 0.025, 16, 28));
    out property <float> ctrl-size: round(clampf(h * 0.095, 50, 82));
    out property <float> ctrl-gap: round(clampf(w * 0.03, 16, 32));
    out property <float> progress-h: max(6, round(progress-h-raw * (tiny ? 0.85 : 1)));
    out property <float> progress-box-h: max(20, round(progress-h * 2.4));
    out property <float> title-px: max(12, round(round(clampf(min-side * 0.07, 18, 48)) * text-scale));
    out property <float> artist-px: max(11, round(round(clampf(min-side * 0.034, 14, 24)) * text-scale));
    out property <float> album-px: max(10, round(round(clampf(min-side * 0.028, 13, 20)) * text-scale));
    out property <float> app-px: max(10, round(12 * text-scale));
    out property <float> bottom-dock-h: ctrl-size + 16 + (progress-h + 20);
    out property <float> content-h: max(0, h - page-pad * 2 - bottom-dock-h);
    out property <float> inner-w: max(0, w - page-pad * 2);
    out property <bool> two-col: inner-w >= 120 + 140 + col-gap;
    out property <float> art-px: round(clampf(min(content-h, art-allowance), 140, 520));
    out property <float> text-side-pad: max(6, round(page-pad * 0.75));
    out property <float> left-w: two-col ? max(0, inner-w - art-px - col-gap) : inner-w;
    out property <float> layout-gap: tiny ? 3 : 4;
    out property <float> top-h: max(0, h - page-pad - bottom-pad - layout-gap * 2 - ctrl-size - progress-box-h - (tiny ? 0 : 8));
    out property <float> art-inset: two-col ? max(0, (top-h - art-px) / 2) : 0;
}

export component Transport inherits Rectangle {
    in property <int> focus-base;
    in property <bool> playing;
    in property <length> size;
    in property <length> gap;
    callback prev();
    callback play-pause();
    callback next();
    height: size;
    HorizontalLayout {
        alignment: center;
        spacing: root.gap;
        RoundButton {
            focused: Focus.main(root.focus-base);
            flash: Press.prev;
            size: root.size;
            icon-size: round(root.size * 0.46 / 1px) * 1px;
            icon: @image-url("icons/SkipPrevious.svg");
            clicked => { root.prev(); }
        }
        RoundButton {
            focused: Focus.main(root.focus-base + 1);
            flash: Press.play;
            size: root.size;
            icon-size: round(root.size * 0.46 / 1px) * 1px;
            icon: root.playing ? @image-url("icons/Pause.svg") : @image-url("icons/PlayArrow.svg");
            clicked => { root.play-pause(); }
        }
        RoundButton {
            focused: Focus.main(root.focus-base + 2);
            flash: Press.next;
            size: root.size;
            icon-size: round(root.size * 0.46 / 1px) * 1px;
            icon: @image-url("icons/SkipNext.svg");
            clicked => { root.next(); }
        }
    }
}
