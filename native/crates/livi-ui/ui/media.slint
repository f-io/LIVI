import { Theme } from "theme.slint";
import { Focus } from "focus.slint";
import { MediaGeometry, MediaSource, MediaText, Press, Spectrum, Transport } from "media_parts.slint";
import { DabPage, DabState, MediaTabs, StationData } from "dab.slint";

export { MediaSource, MediaText, Press, DabState, StationData }


export component Progress inherits Rectangle {
    in property <bool> focused;
    in property <float> progress;
    in property <bool> can-seek;
    in property <float> total-ms;
    in property <float> elapsed-ms;
    in property <length> bar-height;
    in property <color> text-color: Theme.text.with-alpha(0.85);
    callback seek(float);

    property <bool> dragging;
    property <float> drag-share;
    property <float> shown: dragging ? drag-share : progress;
    property <float> shown-ms: shown * total-ms;
    property <length> knob-h: round(bar-height * 2.4 / 1px) * 1px;
    property <length> knob-w: round(knob-h * 1.75 / 1px) * 1px;

    pure function clock(ms: float) -> string {
        let s = floor(max(ms, 0) / 1000);
        let m = floor(s / 60);
        let r = mod(s, 60);
        return m + ":" + (r < 10 ? "0" : "") + r;
    }

    height: max(knob-h, 20px);
    HorizontalLayout {
        spacing: 12px;
        Text {
            min-width: 3.5 * 14px;
            text: root.clock(root.dragging ? root.shown-ms : root.elapsed-ms);
            color: root.text-color;
            font-size: 14px;
            vertical-alignment: center;
        }
        track := Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - root.bar-height) / 2;
                height: root.bar-height;
                border-radius: root.bar-height / 1.6;
                clip: true;
                background: Theme.track;
                drop-shadow-blur: root.focused ? 8px : 0;
                drop-shadow-color: Theme.highlight.with-alpha(0.35);
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown;
                    background: Theme.highlight;
                }
            }
            if root.can-seek: Rectangle {
                width: root.knob-w + 16px;
                height: root.knob-h + 16px;
                y: (parent.height - self.height) / 2;
                x: clamp(parent.width * root.shown - root.knob-w / 2, 0, parent.width - root.knob-w) - 8px;
                border-radius: self.height / 2;
                background: Focus.editing ? Theme.text.with-alpha(0.2) : Theme.highlight.with-alpha(0.3);
                opacity: root.focused ? 1 : 0;
                animate opacity, background { duration: 140ms; }
            }
            if root.can-seek: Rectangle {
                width: root.knob-w;
                height: root.knob-h;
                y: (parent.height - self.height) / 2;
                x: clamp(parent.width * root.shown - self.width / 2, 0, parent.width - self.width);
                border-radius: self.height / 2;
                background: Theme.highlight;
                drop-shadow-blur: 4px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000059;
            }
            TouchArea {
                enabled: root.can-seek && root.total-ms > 0;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.drag-share = clamp(self.mouse-x / self.width, 0, 1);
                    } else if (e.kind == PointerEventKind.up && root.dragging) {
                        root.dragging = false;
                        root.seek(clamp(self.mouse-x / self.width, 0, 1));
                    } else if (e.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    }
                }
                moved => {
                    if (root.dragging) {
                        root.drag-share = clamp(self.mouse-x / self.width, 0, 1);
                    }
                }
            }
        }
        Text {
            min-width: 3.5 * 14px;
            text: "-" + root.clock(root.total-ms - (root.dragging ? root.shown-ms : root.elapsed-ms));
            color: root.text-color;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component PhonePlayer inherits Rectangle {
    in property <int> focus-base;
    in property <length> tabs-h;
    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    geo := MediaGeometry {
        w: root.width / 1px;
        h: root.height / 1px;
    }

    out property <bool> art-shown: geo.two-col;
    property <int> off: focus-base + (geo.two-col ? 1 : 0);

    init => { Focus.media-art = root.art-shown; }
    changed art-shown => { Focus.media-art = root.art-shown; }

    VerticalLayout {
        padding-top: geo.page-pad * 1px;
        padding-left: geo.page-pad * 1px;
        padding-right: geo.page-pad * 1px;
        padding-bottom: geo.bottom-pad * 1px;
        spacing: (geo.tiny ? 3 : 4) * 1px;

        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: geo.col-gap * 1px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 120px;
                    padding-top: geo.art-inset * 1px;
                    padding-bottom: geo.art-inset * 1px;
                    Rectangle { height: root.tabs-h; }
                    VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        padding-left: geo.text-side-pad * 1px;
                        padding-right: geo.two-col ? 0 : geo.text-side-pad * 1px;
                        Text {
                            text: root.track-title;
                            color: Theme.text;
                            font-size: geo.title-px * 1px;
                            font-weight: 800;
                            letter-spacing: 0.2px;
                            overflow: elide;
                        }
                        if geo.two-col: Text {
                            text: root.artist;
                            color: Theme.text.with-alpha(0.9);
                            font-size: geo.artist-px * 1px;
                            overflow: elide;
                        }
                        if geo.two-col: Text {
                            text: root.album;
                            color: Theme.text.with-alpha(0.7);
                            font-size: geo.album-px * 1px;
                            overflow: elide;
                        }
                        Text {
                            text: geo.two-col ? root.app : root.artist;
                            color: Theme.text.with-alpha(0.55);
                            font-size: geo.app-px * 1px;
                            overflow: elide;
                        }
                    }
                }
                if geo.two-col: Rectangle {
                    width: geo.art-px * 1px;
                    Rectangle {
                        width: geo.art-px * 1px;
                        height: geo.art-px * 1px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 34px;
                        border-width: Focus.main(root.focus-base) ? 3px : 0;
                        border-color: Theme.primary;
                        clip: true;
                        background: root.show-spectrum ? transparent : Theme.surface;
                        if !root.show-spectrum && root.has-artwork: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.artwork;
                            image-fit: cover;
                        }
                        if !root.show-spectrum && !root.has-artwork: Text {
                            text: MediaText.no-artwork;
                            color: Theme.text.with-alpha(0.6);
                            font-size: 12px;
                        }
                        if root.show-spectrum: Spectrum {
                            x: max(8, round(geo.art-px * 0.06)) * 1px;
                            y: self.x + (parent.height - 2 * self.x) * 0.075;
                            width: parent.width - 2 * self.x;
                            height: (parent.height - 2 * self.x) * 0.85;
                            bands: root.bands;
                        }
                        TouchArea {
                            clicked => {
                                root.show-spectrum = !root.show-spectrum;
                                root.spectrum-changed(root.show-spectrum);
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: (geo.tiny ? 3 : 4) * 1px;
            padding-bottom: geo.tiny ? 0 : 8px;
            Transport {
                focus-base: root.off;
                playing: root.playing;
                size: geo.ctrl-size * 1px;
                gap: geo.ctrl-gap * 1px;
                prev => { root.prev(); }
                play-pause => { root.play-pause(); }
                next => { root.next(); }
            }
            Progress {
                focused: root.can-seek && Focus.main(root.off + 3);
                progress: root.progress;
                can-seek: root.can-seek;
                total-ms: root.total-ms;
                elapsed-ms: root.elapsed-ms;
                bar-height: geo.progress-h * 1px;
                seek(f) => { root.seek(f); }
            }
        }
    }
}

export component MediaPage inherits Rectangle {
    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    property <int> base: DabState.receiver ? 3 : 0;
    property <bool> dab-shown: DabState.receiver && DabState.view != MediaSource.phone;
    property <length> tabs-h: DabState.receiver ? tabs.height + (geo.tiny ? 4px : 8px) : 0;

    geo := MediaGeometry {
        w: root.width / 1px;
        h: root.height / 1px;
    }

    background: Theme.background;

    if !root.dab-shown: PhonePlayer {
        width: parent.width;
        height: parent.height;
        focus-base: root.base;
        tabs-h: root.tabs-h;
        track-title: root.track-title;
        artist: root.artist;
        album: root.album;
        app: root.app;
        artwork: root.artwork;
        has-artwork: root.has-artwork;
        playing: root.playing;
        progress: root.progress;
        elapsed-ms: root.elapsed-ms;
        total-ms: root.total-ms;
        can-seek: root.can-seek;
        show-spectrum <=> root.show-spectrum;
        bands: root.bands;
        play-pause => { root.play-pause(); }
        prev => { root.prev(); }
        next => { root.next(); }
        seek(f) => { root.seek(f); }
        spectrum-changed(on) => { root.spectrum-changed(on); }
    }
    if root.dab-shown: DabPage {
        width: parent.width;
        height: parent.height;
        focus-base: root.base;
        tabs-h: root.tabs-h;
        show-spectrum <=> root.show-spectrum;
        bands: root.bands;
        spectrum-changed(on) => { root.spectrum-changed(on); }
    }
    tabs := MediaTabs {
        visible: DabState.receiver;
        room: geo.left-w * 1px;
        x: geo.page-pad * 1px + max(0, geo.left-w * 1px - self.width) / 2;
        y: (geo.page-pad + geo.art-inset) * 1px;
    }
}
