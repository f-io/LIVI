import { Theme } from "theme.slint";
import { ViewArea, ViewAreaMask, MaskData } from "mask.slint";
import { VideoControls } from "video_controls.slint";

export enum TouchPhase { down, move, up, cancel }

export component ProjectionPage inherits Rectangle {
    in property <int> stream-width: 1280;
    in property <int> stream-height: 720;
    in property <bool> streaming;
    in property <bool> waiting;
    in property <MaskData> mask;
    in property <ViewArea> view-area;
    in property <image> idle-icon;
    in property <bool> video-shown;
    in property <bool> video-playing;
    in property <float> video-elapsed-ms;
    in property <float> video-total-ms;
    in property <bool> video-can-seek;
    in property <bool> mirrored;
    in property <bool> held;
    in-out property <bool> mirror-shown;
    in-out property <int> mirror-idle;
    callback touch(TouchPhase, float, float);
    callback video-play-pause();
    callback video-seek(float);
    callback video-close();
    callback mirror-leave();

    background: root.streaming ? transparent : Theme.background;

    Rectangle {
        width: min(root.width, root.height * root.stream-width / root.stream-height);
        height: min(root.height, root.width * root.stream-height / root.stream-width);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        TouchArea {
            enabled: root.streaming && !root.video-shown && !root.mirrored;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.touch(TouchPhase.down, self.mouse-x / self.width, self.mouse-y / self.height);
                } else if (e.kind == PointerEventKind.up) {
                    root.touch(TouchPhase.up, self.mouse-x / self.width, self.mouse-y / self.height);
                } else if (e.kind == PointerEventKind.cancel) {
                    root.touch(TouchPhase.cancel, self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
            moved => {
                if (self.pressed) {
                    root.touch(TouchPhase.move, self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
        }
    }

    if root.streaming: ViewAreaMask {
        mask: root.mask;
    }

    if root.streaming && root.held: Rectangle {
        background: Theme.background;

        Image {
            source: @image-url("icons/TvOffOutlined.svg");
            width: min(root.width, root.height) * 0.15;
            height: self.width;
            colorize: Theme.text-secondary;
        }
    }

    if root.streaming && (root.video-shown || root.mirrored): VideoControls {
        x: root.view-area.left * 1phx;
        y: root.view-area.top * 1phx;
        width: max(1px, root.width - (root.view-area.left + root.view-area.right) * 1phx);
        height: max(1px, root.height - (root.view-area.top + root.view-area.bottom) * 1phx);
        playing: root.video-playing;
        elapsed-ms: root.video-elapsed-ms;
        total-ms: root.video-total-ms;
        can-seek: root.video-can-seek;
        mirrored: root.mirrored && !root.video-shown;
        shown <=> root.mirror-shown;
        idle <=> root.mirror-idle;
        play-pause => { root.video-play-pause(); }
        seek(f) => { root.video-seek(f); }
        close => {
            if (root.video-shown) {
                root.video-close();
            } else {
                root.mirror-leave();
            }
        }
    }

    if !root.streaming: Image {
        source: root.idle-icon;
        width: min(root.width, root.height) * 0.15;
        height: self.width;
        colorize: Theme.text-secondary;
        opacity: root.waiting ? 0.6 + 0.4 * sin(animation-tick() / 1600ms * 360deg) : 1;
    }
}
