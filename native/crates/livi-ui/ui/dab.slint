import { Theme } from "theme.slint";
import { Focus, FocusZone } from "focus.slint";
import { MediaGeometry, MediaSource, MediaText, RoundButton, Spectrum, SourceTabs } from "media_parts.slint";

export struct StationData {
    id: int,
    number: int,
    label: string,
    favorite: bool,
    tuned: bool,
    has-logo: bool,
    logo: image,
    initials: string,
    badge: color,
}

/// The radio page, filled with the band in `view`.
export global DabState {
    in property <bool> receiver;
    in property <string> source;
    in property <bool> tunable;
    in property <bool> stereo;
    in property <bool> active;
    in property <bool> playing;
    in property <string> title;
    in property <string> text;
    in property <string> ensemble;
    in property <int> signal-bars;
    in property <bool> has-tuned;
    in property <bool> favorite;
    in property <bool> has-logo;
    in property <image> logo;
    in property <string> initials;
    in property <color> badge;
    in property <[StationData]> stations;
    in property <int> tuned-index: -1;
    in property <int> picked: -1;
    in-out property <bool> band-shown: true;
    in-out property <bool> art-shown;
    in-out property <MediaSource> view;
    callback phone();
    callback resume();
    callback resume-fm();
    callback pick(int);
    callback toggle-favorite();
}

export component StationBadge inherits Rectangle {
    in property <length> size;
    in property <bool> has-logo;
    in property <image> logo;
    in property <string> initials;
    in property <color> badge;
    width: size;
    height: size;
    border-radius: round(size * 0.18 / 1px) * 1px;
    clip: true;
    background: has-logo ? #ffffff : badge;
    if root.has-logo: Image {
        width: parent.width;
        height: parent.height;
        source: root.logo;
        image-fit: contain;
    }
    if !root.has-logo: Text {
        text: root.initials;
        color: #ffffff;
        font-weight: 800;
        font-size: round(root.size * (root.initials.character-count > 4 ? 0.29 : 0.36) / 1px) * 1px;
    }
}

component StationTile inherits Rectangle {
    in property <StationData> station;
    in property <length> tile;
    in property <bool> focused;
    callback picked();
    property <float> k: min(1, root.tile / 112px);
    property <bool> on-air: DabState.picked >= 0 ? root.station.id == DabState.picked : root.station.tuned && DabState.playing;
    width: tile;
    height: tile;
    border-radius: 10px;
    border-width: root.on-air ? 2px : 0;
    border-color: Theme.primary;
    background: root.focused ? (Theme.dark ? #ffffff33 : #00000026) : root.on-air ? (Theme.dark ? #ffffff24 : #0000001a) : Theme.surface;
    Rectangle {
        border-radius: 10px;
        border-width: root.focused ? 3px : 0;
        border-color: Theme.primary;
    }
    Text {
        x: parent.width - self.width - round(8 * root.k) * 1px;
        y: round(4 * root.k) * 1px;
        text: root.station.number;
        font-size: max(9px, round(12 * root.k) * 1px);
        color: Theme.text;
        opacity: 0.7;
    }
    VerticalLayout {
        alignment: center;
        spacing: round(6 * root.k) * 1px;
        padding-left: 6px;
        padding-right: 6px;
        HorizontalLayout {
            alignment: center;
            StationBadge {
                size: round(root.tile * 0.55 / 1px) * 1px;
                has-logo: root.station.has-logo;
                logo: root.station.logo;
                initials: root.station.initials;
                badge: root.station.badge;
            }
        }
        Text {
            text: root.station.label;
            font-size: max(9px, round(12 * root.k) * 1px);
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if root.station.favorite: Image {
        x: parent.width - self.width - round(4 * root.k) * 1px;
        y: parent.height - self.height - round(4 * root.k) * 1px;
        width: max(11px, round(18 * root.k) * 1px);
        height: self.width;
        source: @image-url("icons/StarRounded.svg");
        colorize: #ffa726;
    }
    TouchArea {
        clicked => { root.picked(); }
    }
}

component StationBand inherits Rectangle {
    in property <length> tile;
    in property <int> focus-base;
    property <length> step: tile + 8px;
    property <int> focused-index: Focus.zone == FocusZone.main ? Focus.main-index - focus-base : -1;

    function show(i: int) {
        if (i < 0) {
            return;
        }
        let left = 8px + i * root.step;
        if (left + flick.content-x < 0) {
            flick.content-x = -left + 8px;
        } else if (left + root.tile + flick.content-x > flick.width) {
            flick.content-x = flick.width - left - root.tile - 8px;
        }
    }

    changed focused-index => { root.show(root.focused-index); }
    init => { root.show(DabState.tuned-index); }
    changed width => { root.show(DabState.tuned-index); }

    height: tile + 16px;
    border-radius: 12px;
    background: Theme.surface;
    clip: true;
    flick := Flickable {
        content-width: max(self.width, 8px + DabState.stations.length * root.step);
        content-height: self.height;
        for st[i] in DabState.stations: StationTile {
            x: 8px + i * root.step;
            y: 8px;
            tile: root.tile;
            station: st;
            focused: root.focused-index == i;
            picked => { DabState.pick(st.id); }
        }
    }
    property <int> tuned: DabState.tuned-index;
    changed tuned => { root.show(root.tuned); }
}

export component MediaTabs inherits SourceTabs {
    view: DabState.view;
    focus-base: 0;
    phone => { DabState.phone(); }
    dab => { DabState.resume(); }
    fm => { DabState.resume-fm(); }
}

export component DabPage inherits Rectangle {
    in property <int> focus-base;
    in property <length> tabs-h;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;
    callback spectrum-changed(bool);

    geo := MediaGeometry {
        w: root.width / 1px;
        h: root.height / 1px;
    }

    property <bool> compact: geo.tiny;
    property <length> page-pad: geo.page-pad * 1px;
    property <length> pad: geo.text-side-pad * 1px;
    property <length> block-y: root.page-pad + geo.art-inset * 1px;
    property <length> block-h: max(0, (geo.top-h - geo.art-inset * 2) * 1px);
    property <length> phone-text-h: geo.two-col
        ? m-title.preferred-height + m-artist.preferred-height + m-album.preferred-height + m-app.preferred-height
        : m-title.preferred-height + m-app.preferred-height;
    property <length> title-y: root.block-y + root.tabs-h + (root.block-h - root.tabs-h - root.phone-text-h) / 2;
    property <length> line-h: round((geo.album-px + 2) * 1.4) * 1px;
    property <length> text-top: root.title-y + title.height;
    property <length> art: geo.art-px * 1px;
    property <bool> art-shown: geo.two-col;
    property <length> art-y: root.page-pad + (geo.top-h * 1px - root.art) / 2;
    property <length> gap: geo.layout-gap * 1px;
    property <length> band-bottom: root.height - geo.bottom-pad * 1px - (root.compact ? 0 : 8px);
    property <length> logo: round(root.art * 0.62 / 1px) * 1px;
    property <length> logo-x: root.width - root.page-pad - root.art / 2 - root.logo / 2;
    property <length> logo-top: root.art-y + root.tabs-h;
    property <length> logo-y: root.logo-top + max(0, (root.band-bottom - root.band-h - root.band-gap - root.logo-top - root.logo) / 2);
    property <length> band-gap: 12px;
    property <length> band-top: max(root.text-top + m-artist.preferred-height, root.art-shown ? root.logo-top + root.logo : 0) + root.band-gap;
    property <length> tile: round(max(48px, min(140px, root.band-bottom - root.band-top - 16px)) / 1px) * 1px;
    property <length> band-h: root.tile + 16px;
    property <bool> two-lines: root.text-top + m-artist.preferred-height * 2 + 8px <= root.band-top;
    property <length> radio-text-h: m-artist.preferred-height * (root.two-lines ? 2 : 1);
    property <length> text-w: max(0, root.width - root.page-pad * 2 - root.pad - (root.art-shown ? root.art + geo.col-gap * 1px : root.pad));
    property <int> off: focus-base + (art-shown ? 2 : 0);
    property <length> fav: round(max(32px, min(56px, root.logo * 0.2)) / 1px) * 1px;
    property <length> fav-inset: round(max(4px, root.logo * 0.04) / 1px) * 1px;

    init => {
        DabState.band-shown = true;
        DabState.art-shown = root.art-shown;
    }
    changed art-shown => { DabState.art-shown = root.art-shown; }

    m-title := Text { visible: false; text: "Ag"; font-size: geo.title-px * 1px; font-weight: 800; letter-spacing: 0.2px; }
    m-artist := Text { visible: false; text: "Ag"; font-size: geo.artist-px * 1px; }
    m-album := Text { visible: false; text: "Ag"; font-size: geo.album-px * 1px; }
    m-app := Text { visible: false; text: "Ag"; font-size: geo.app-px * 1px; }

    if !root.compact: HorizontalLayout {
        x: root.page-pad + root.pad;
        y: root.title-y - root.line-h;
        width: root.text-w;
        height: root.line-h;
        spacing: 10px;
        alignment: start;
        Text {
            text: DabState.source;
            color: Theme.primary;
            font-weight: 800;
            font-size: geo.album-px * 1px;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Text {
            text: DabState.ensemble;
            color: Theme.text.with-alpha(0.7);
            font-size: geo.album-px * 1px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: (geo.album-px + 2) * 1px;
            if DabState.signal-bars > 0: Image {
                width: parent.width;
                height: parent.width;
                colorize: Theme.primary;
                source: DabState.signal-bars >= 3 ? @image-url("icons/SignalCellularAlt.svg")
                    : DabState.signal-bars == 2 ? @image-url("icons/SignalCellularAlt2Bar.svg")
                    : @image-url("icons/SignalCellularAlt1Bar.svg");
            }
        }
        // Stereo as two overlapping rings, in a space kept free so nothing moves.
        Rectangle {
            property <length> ring: (geo.album-px + 2) * 0.7px;
            width: self.ring * 1.6;
            if DabState.stereo: Rectangle {
                x: 0;
                width: parent.ring;
                height: parent.ring;
                border-radius: self.width / 2;
                border-width: max(1.5px, parent.ring * 0.13);
                border-color: Theme.primary;
            }
            if DabState.stereo: Rectangle {
                x: parent.ring * 0.6;
                width: parent.ring;
                height: parent.ring;
                border-radius: self.width / 2;
                border-width: max(1.5px, parent.ring * 0.13);
                border-color: Theme.primary;
            }
        }
    }
    title := Text {
        x: root.page-pad + root.pad;
        y: root.title-y;
        width: root.text-w;
        text: DabState.title;
        color: Theme.text;
        font-weight: 800;
        font-size: geo.title-px * 1px;
        letter-spacing: 0.2px;
        overflow: elide;
    }
    Text {
        x: root.page-pad + root.pad;
        y: root.text-top;
        width: root.text-w;
        height: root.radio-text-h;
        text: DabState.text;
        color: Theme.text.with-alpha(0.9);
        font-size: (root.compact ? geo.app-px : geo.artist-px) * 1px;
        wrap: root.two-lines ? word-wrap : no-wrap;
        overflow: elide;
    }
    if root.art-shown: Rectangle {
        x: root.logo-x;
        y: root.logo-y;
        width: root.logo;
        height: root.logo;
        border-radius: round(root.logo * 0.18 / 1px) * 1px;
        clip: true;
        if !root.show-spectrum: StationBadge {
            size: root.logo;
            has-logo: DabState.has-logo;
            logo: DabState.logo;
            initials: DabState.initials;
            badge: DabState.badge;
        }
        if root.show-spectrum: Spectrum {
            x: max(6px, round(root.logo * 0.06 / 1px) * 1px);
            y: self.x + (parent.height - 2 * self.x) * 0.075;
            width: parent.width - 2 * self.x;
            height: (parent.height - 2 * self.x) * 0.85;
            bands: root.bands;
        }
        Rectangle {
            border-radius: parent.border-radius;
            border-width: Focus.main(root.focus-base) ? 3px : 0;
            border-color: Theme.primary;
        }
        TouchArea {
            clicked => {
                root.show-spectrum = !root.show-spectrum;
                root.spectrum-changed(root.show-spectrum);
            }
        }
        RoundButton {
            x: parent.width - self.width - root.fav-inset;
            y: parent.height - self.height - root.fav-inset;
            focused: Focus.main(root.focus-base + 1);
            enabled: DabState.has-tuned;
            size: root.fav;
            icon-size: round(root.fav * 0.5 / 1px) * 1px;
            icon: DabState.favorite ? @image-url("icons/StarRounded.svg") : @image-url("icons/StarBorderRounded.svg");
            icon-color: DabState.favorite ? #ffa726 : Theme.text;
            clicked => { DabState.toggle-favorite(); }
        }
    }
    if DabState.stations.length == 0: Text {
        x: root.page-pad;
        y: root.band-bottom - root.band-h;
        width: root.width - root.page-pad * 2;
        height: root.band-h;
        text: DabState.tunable ? MediaText.no-fm-stations : MediaText.no-stations;
        color: Theme.text.with-alpha(0.7);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if DabState.stations.length > 0: StationBand {
        x: root.page-pad;
        y: root.band-bottom - root.band-h;
        width: root.width - root.page-pad * 2;
        tile: root.tile;
        focus-base: root.off;
    }
}
