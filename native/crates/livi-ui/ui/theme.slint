export global Theme {
    in property <bool> dark: true;
    in property <color> primary-override: transparent;
    in property <color> highlight-override: transparent;
    in property <color> background-override: transparent;
    in property <color> text-override: transparent;

    out property <color> background: background-override.alpha > 0 ? background-override : (dark ? #0b0b0b : #ece7de);
    out property <color> paper: background.mix(dark ? #ffffff : #000000, 0.93);
    out property <color> text: text-override.alpha > 0 ? text-override : (dark ? #f5f0e8 : #1a1a1a);
    out property <color> text-secondary: text.with-alpha(dark ? 0.73 : 0.8);
    out property <color> text-disabled: text.with-alpha(dark ? 0.5 : 0.38);
    out property <color> primary: primary-override.alpha > 0 ? primary-override : (dark ? #ffa500 : #c77700);
    out property <color> highlight: highlight-override.alpha > 0 ? highlight-override : (dark ? #e08f00 : #a86400);
    out property <color> divider: dark ? #303030 : #c9c1b4;
    out property <color> surface: dark ? #ffffff0f : #0000000f;
    out property <color> button: #ffffff29;
    out property <color> button-active: #ffffff3d;
    out property <color> track: #ffffff47;
}

export global Ui {
    in property <length> width: 1280px;
    in property <length> height: 720px;
    out property <bool> xs-icons: height <= 320px;
    out property <bool> show-clock: height > 220px;
    out property <length> icon-size: xs-icons ? 24px : 32px;
    out property <length> nav-width: 56px;
    out property <length> nav-pad: 7px;
}
