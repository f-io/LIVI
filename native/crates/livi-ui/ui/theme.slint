export global Theme {
    in property <bool> dark: true;
    in property <color> primary-override: transparent;
    in property <color> highlight-override: transparent;
    in property <color> background-override: transparent;
    in property <color> text-override: transparent;

    out property <color> background: background-override.alpha > 0 ? background-override : (dark ? #000000 : #f5f5f5);
    out property <color> paper: background.mix(dark ? #ffffff : #000000, 0.93);
    out property <color> text: text-override.alpha > 0 ? text-override : (dark ? #ffffff : #000000);
    out property <color> text-secondary: text.with-alpha(dark ? 0.73 : 0.8);
    out property <color> text-disabled: text.with-alpha(dark ? 0.5 : 0.38);
    out property <color> primary: primary-override.alpha > 0 ? primary-override : (dark ? #00adad : #008585);
    out property <color> highlight: highlight-override.alpha > 0 ? highlight-override : (dark ? #009494 : #007575);
    out property <color> divider: dark ? #ffffff33 : #0000001f;
    out property <color> hairline: text.with-alpha(dark ? 0.08 : 0.1);
    out property <color> icon-dim: text.with-alpha(dark ? 0.55 : 0.6);
    out property <color> lit: text.with-alpha(0.07);
    out property <color> lit-pressed: text.with-alpha(0.1);
    out property <color> surface: dark ? #ffffff0f : #0000000f;
    out property <color> button: dark ? #ffffff29 : #0000001a;
    out property <color> button-active: dark ? #ffffff3d : #0000002e;
    out property <color> track: dark ? #ffffff47 : #00000033;
}

export global Ui {
    in property <length> width: 1280px;
    in property <length> height: 720px;
    out property <bool> xs-icons: height <= 320px;
    out property <bool> show-clock: height > 220px;
    out property <length> icon-size: xs-icons ? 24px : 32px;
    out property <length> nav-width: 56px;
    out property <length> nav-pad: 7px;
}
