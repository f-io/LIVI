{
  "lineWidth": 120,
  "markdown": {
    "html.skipFormat": true
  },
  "yaml": {
    "quotes": "preferDouble"
  },
  "toml": {
    "cargo.applyConventions": false
  },
  "excludes": [
    "**/target",
    "**/node_modules",
    "dist",
    "assets",
    "native/vendor",
    "native/crates/livi-ui/fixtures",
    "native/crates/**/*vectors.json"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
