/dts-v1/;

/memreserve/	0x0000000080fc0000 0x0000000000040000;
/ {
	model = "sun300iw1p1";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	board = "V821", "V821-Perf2";
	compatible = "allwinner,v821", "riscv,sun300iw1p1";

	vf_mapping_table: vf_mapping_table {
		vf-version = "V0.4";
		table = <0x00 0x00>;
		phandle = <0x5c>;
	};

	cpu_opp_table_vf0_1: cpu_opp_table_vf0_1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x02>;

		opp@360000000 {
			opp-hz = <0x00 0x15752a00>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@720000000 {
			opp-hz = <0x00 0x2aea5400>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@840000000 {
			opp-hz = <0x00 0x32116200>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@960000000 {
			opp-hz = <0x00 0x39387000>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-40m-vf0000 = <0xe09c0>;
			clock-latency-ns = <0x3b9b0>;
			status = "disabled";
		};

		opp@1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt-vf0000 = <0xe09c0>;
			opp-microvolt-40m-vf0000 = <0x00>;
			clock-latency-ns = <0x3b9b0>;
			status = "disabled";
		};
	};

	cpu_opp_table_vf2_1: cpu_opp_table_vf2_1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x5d>;

		opp@360000000 {
			opp-hz = <0x00 0x15752a00>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@720000000 {
			opp-hz = <0x00 0x2aea5400>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@840000000 {
			opp-hz = <0x00 0x32116200>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@960000000 {
			opp-hz = <0x00 0x39387000>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0x00>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1080000000 {
			opp-hz = <0x00 0x405f7e00>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1104000000 {
			opp-hz = <0x00 0x41cdb400>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0x00>;
			clock-latency-ns = <0x3b9b0>;
		};

		opp@1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-40m-vf0000 = <0xf4240>;
			clock-latency-ns = <0x3b9b0>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x4000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x400000>;
			alignment = <0x00 0x2000>;
			linux,cma-default;
		};

		efuse_ram_reserved: efuse_ram@80ffff00 {
			reg = <0x00 0x80ffff00 0x00 0x100>;
			no-map;
			phandle = <0x16>;
		};
	};

	aliases {
		serial0 = "/soc@2002000/uart@42500000";
		serial1 = "/soc@2002000/uart@42500400";
		serial2 = "/soc@2002000/uart@42500800";
		serial3 = "/soc@2002000/uart@42500c00";
		twi0 = "/soc@2002000/twi0@42502000";
		twi1 = "/soc@2002000/twi1@42502400";
		twi2 = "/soc@2002000/twi2@42502800";
		gpadc0 = "/soc@2002000/gpadc0@42009000";
		spi0 = "/soc@2002000/spi@44025000";
		spi1 = "/soc@2002000/spi@44026000";
		spi2 = "/soc@2002000/spi@44027000";
		spif0 = "/soc@2002000/spif@44f00000";
		gmac0 = "/soc@2002000/gmac@44500000";
		soc_pmu0 = "/soc@2002000/soc_pmu0@4A000800";
		pwm0 = "/soc@2002000/pwm@42000c00";
	};

	chosen {
		bootargs = "earlyprintk=sunxi-uart,0x42500000 loglevel=8 initcall_debug=1 console=ttyAS0 init=/init";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <0x2625a00>;

		cpu0: cpu@0 {
			compatible = "riscv";
			reg = <0x00>;
			device_type = "cpu";
			riscv,isa = "rv32i2p0m2p0a2p0f2p0d2p0c2p0xv5-0p0";
			enable-method = "psci";
			capacity-dmips-mhz = <0x20b>;
			i-cache-size = <0x4000>;
			i-cache-line-size = <0x40>;
			d-cache-size = <0x4000>;
			d-cache-line-size = <0x40>;
			next-level-cache = <0x01>;
			clocks = <0x01 0x21>;
			clock-latency = <0x1e8480>;
			operating-points-v2 = <0x02>;
			#cooling-cells = <0x02>;
			dynamic-power-coefficient = <0x8e>;
			status = "okay";
			phandle = <0x05>;

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <0x01>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
				phandle = <0x06>;
			};
		};
	};

	andes_pmu: pmu {
		compatible = "riscv,andes-pmu";
		status = "okay";
		phandle = <0x5e>;
	};

	thermal-zones {

		cpu_thermal_zone: cpu_thermal_zone {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x03 0x00>;
			sustainable-power = <0x44>;
			phandle = <0x5f>;

			cpu_trips: trips {
				phandle = <0x60>;

				cpu_threshold: trip-point@0 {
					temperature = <0x11170>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x61>;
				};

				cpu_target: trip-point@1 {
					temperature = <0x15f90>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x04>;
				};

				cpu_crit: cpu_crit@0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
					phandle = <0x62>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x04>;
					cooling-device = <0x05 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		ve_thermal_zone: ve_thermal_zone {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x2710>;
			thermal-sensors = <0x03 0x01>;
			phandle = <0x63>;
		};
	};

	l2-cache@49000000 {
		compatible = "cache";
		reg = <0x00 0x49000000 0x00 0x300>;
		cache-level = <0x02>;
		cache-size = <0x20000>;
		andes,inst-prefetch = <0x03>;
		andes,data-prefetch = <0x03>;
		andes,tag-ram-ctl = <0x00 0x00>;
		andes,data-ram-ctl = <0x00 0x00>;
	};

	losc: losc_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x7d00>;
		clock-output-names = "losc";
		phandle = <0x0a>;
	};

	dcxo24M: dcxo24M_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "dcxo24M";
		phandle = <0x08>;
	};

	dcxo40M: dcxo40M_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x2625a00>;
		clock-output-names = "dcxo40M";
		phandle = <0x64>;
	};

	mbus0: mbus-controller@43102000 {
		compatible = "allwinner,generic-mbus";
		reg = <0x00 0x43102000 0x00 0x1000>;
		#mbus-cells = <0x01>;
		status = "okay";
		master_pmu_names = "pmu_cpuddr", "pmu_riscv_sys", "pmu_mahb_ddr", "pmu_dma_ddr", "pmu_ve_ddr", "pmu_csi_ddr", "pmu_isp_sys", "pmu_g2d_ddr", "pmu_de_ddr", "pmu_othddr", "pmu_totddr";
		master_pmu_idxs = <0x00 0x01 0x02 0x03 0x05 0x07 0x08 0x09 0x0a 0x0e 0x0f>;
		master_port_idxs = <0x00 0x02 0x03 0x04 0x0b 0x0c 0x0d 0x10 0x17 0x27>;
		phandle = <0x65>;
	};

	soc: soc@2002000 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		device_type = "soc";
		phandle = <0x66>;

		plic0: interrupt-controller@48000000 {
			compatible = "riscv,plic0";
			#address-cells = <0x02>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			reg = <0x00 0x48000000 0x00 0x400000>;
			riscv,ndev = <0xbb>;
			interrupts-extended = <0x06 0x0b 0x06 0x09>;
			phandle = <0x07>;
		};

		aon_ccu: aon_ccu@4a010000 {
			compatible = "allwinner,sun300iw1-aon-ccu";
			reg = <0x00 0x4a010000 0x00 0x600>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x01>;
		};

		ccu: ccu@42001000 {
			compatible = "allwinner,sun300iw1-app-ccu";
			reg = <0x00 0x42001000 0x00 0x100>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x09>;
		};

		prcm_ccu: prcm_ccu@4a000000 {
			compatible = "allwinner,sun300iw1-prcm-ccu";
			reg = <0x00 0x4a000000 0x00 0x40>;
			sysrtc_reg = <0x00 0x4a000c00 0x00 0x10>;
			clocks = <0x01 0x19>;
			clock-names = "hosc";
			extern_32k = "disabled";
			extern_fre = <0x8000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x18>;
		};

		soc_timer0: timer@43008000 {
			compatible = "allwinner,hstimer-v100";
			device_type = "soc_timer";
			reg = <0x00 0x43008000 0x00 0x400>;
			interrupts-extended = <0x07 0x38 0x04>;
			clocks = <0x08 0x09 0x3d>;
			clock-names = "parent", "bus";
			resets = <0x09 0x17>;
			phandle = <0x67>;
		};

		pio: pinctrl@42000000 {
			compatible = "allwinner,sun300iw1-pinctrl";
			reg = <0x00 0x42000000 0x00 0x500>;
			interrupts-extended = <0x07 0x44 0x04 0x07 0x48 0x04 0x07 0x4a 0x04>;
			clocks = <0x01 0x1b 0x01 0x19 0x0a>;
			clock-names = "apb", "hosc", "losc";
			device_type = "pio";
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			#address-cells = <0x00>;
			#gpio-cells = <0x03>;
			input-debounce = <0x19 0x00 0x00>;
			phandle = <0x0d>;

			sdc0_pins_a: sdc0@0 {
				pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
				function = "sdc0";
				allwinner,drive = <0x03>;
				bias-pull-up;
				phandle = <0x3e>;
			};

			sdc0_pins_b: sdc0@1 {
				pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
				function = "sdc0";
				allwinner,drive = <0x03>;
				bias-pull-up;
				phandle = <0x68>;
			};

			sdc0_pins_c: sdc0@2 {
				pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
				function = "gpio_in";
				phandle = <0x3f>;
			};

			sdc1_pins_a: sdc1@0 {
				pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6";
				function = "sdc1";
				allwinner,drive = <0x03>;
				bias-pull-up;
				allwinner,pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6";
				allwinner,function = "sdc1";
				allwinner,muxsel = <0x06>;
				allwinner,pull = <0x01>;
				phandle = <0x40>;
			};

			sdc1_pins_b: sdc1@1 {
				pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6";
				function = "gpio_in";
				allwinner,pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6";
				allwinner,function = "io_disabled";
				allwinner,muxsel = <0x07>;
				allwinner,drive = <0x01>;
				allwinner,pull = <0x01>;
				phandle = <0x41>;
			};

			csi_mclk0_pins_a: csi_mclk0@0 {
				pins = "PA1";
				function = "mipi";
				allwinner,drive = <0x00>;
				phandle = <0x47>;
			};

			csi_mclk0_pins_b: csi_mclk0@1 {
				pins = "PA1";
				function = "gpio_in";
				phandle = <0x48>;
			};

			csi_mclk1_pins_a: csi_mclk1@0 {
				pins = "PA2";
				function = "mipi";
				allwinner,drive = <0x00>;
				phandle = <0x49>;
			};

			csi_mclk1_pins_b: csi_mclk1@1 {
				pins = "PA2";
				function = "gpio_in";
				phandle = <0x4a>;
			};

			ncsi_bt656_pins_a: ncsi_BT656@0 {
				pins = "PD1", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12";
				function = "ncsi";
				allwinner,drive = <0x00>;
				phandle = <0x4b>;
			};

			ncsi_bt656_pins_b: ncsi_BT656@1 {
				pins = "PD1", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12";
				function = "gpio_in";
				phandle = <0x4c>;
			};

			ncsi_bt1120_pins_a: ncsi_BT1120@0 {
				pins = "PD1", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20";
				function = "ncsi";
				allwinner,drive = <0x00>;
				phandle = <0x69>;
			};

			ncsi_bt1120_pins_b: ncsi_BT1120@1 {
				pins = "PD1", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20";
				function = "gpio_in";
				phandle = <0x6a>;
			};

			mipia_pins_a: mipia@0 {
				pins = "PA5", "PA6", "PA7", "PA8";
				function = "mipia";
				allwinner,drive = <0x00>;
				phandle = <0x4d>;
			};

			mipia_pins_b: mipia@1 {
				pins = "PA5", "PA6", "PA7", "PA8";
				function = "gpio_in";
				phandle = <0x4e>;
			};

			mipib_pins_a: mipib@0 {
				pins = "PA11", "PA12", "PA9", "PA10";
				function = "mipib";
				allwinner,drive = <0x00>;
				phandle = <0x51>;
			};

			mipib_pins_b: mipib@1 {
				pins = "PA11", "PA12", "PA9", "PA10";
				function = "gpio_in";
				phandle = <0x52>;
			};

			mipib_2lane_pins_a: mipib_2lane@0 {
				pins = "PA11", "PA12", "PA9", "PA10";
				function = "mipib";
				allwinner,drive = <0x00>;
				phandle = <0x4f>;
			};

			mipib_2lane_pins_b: mipib_2lane@1 {
				pins = "PA11", "PA12", "PA9", "PA10";
				function = "gpio_in";
				phandle = <0x50>;
			};

			test_pins_a: test_pins@0 {
				pins = "PC12", "PC13";
				function = "test";
				allwinner,drive = <0x00>;
				bias-pull-up;
				phandle = <0x0b>;
			};

			test_pins_b: test_pins@1 {
				pins = "PC12", "PC13";
				function = "gpio_in";
				phandle = <0x0c>;
			};

			rgb8_pins_a: serial_rgb@0 {
				pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8";
				function = "lcd";
				allwinner,drive = <0x01>;
				phandle = <0x6b>;
			};

			rgb8_pins_b: serial_rgb@1 {
				pins = "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8";
				function = "io_disabled";
				phandle = <0x6c>;
			};

			rgb8_pins_ctl_a: serial_rgb_ctl@0 {
				pins = "PD9", "PD10", "PD11", "PD12";
				function = "lcds_ctl";
				allwinner,drive = <0x01>;
				phandle = <0x6d>;
			};

			rgb8_pins_ctl_b: serial_rgb_ctl@1 {
				pins = "PD9", "PD10", "PD11", "PD12";
				function = "io_disabled";
				phandle = <0x6e>;
			};

			uart1_pins_default: uart1_pins@0 {
				pins = "PD7", "PD8", "PD9", "PD10";
				function = "uart1";
				phandle = <0x10>;
			};

			uart1_pins_sleep: uart1_pins@1 {
				pins = "PD7", "PD8", "PD9", "PD10";
				function = "io_disabled";
				phandle = <0x11>;
			};

			uart2_pins_default: uart2_pins@0 {
				pins = "PC4", "PC5";
				function = "uart2";
				phandle = <0x12>;
			};

			uart2_pins_sleep: uart2_pins@1 {
				pins = "PC4", "PC5";
				function = "io_disabled";
				phandle = <0x13>;
			};

			uart3_pins_default: uart3_pins@0 {
				pins = "PC0", "PC1", "PC2", "PC3";
				function = "uart3";
				phandle = <0x14>;
			};

			uart3_pins_sleep: uart3_pins@1 {
