			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name = "sndi2s0";
			soundcard-mach,format = "i2s";
			soundcard-mach,slot-num = <0x02>;
			soundcard-mach,slot-width = <0x20>;
			status = "disabled";
			soundcard-mach,frame-master = <0x58>;
			soundcard-mach,bitclock-master = <0x58>;
			phandle = <0xb5>;

			i2s0_cpu: soundcard-mach,cpu {
				sound-dai = <0x59>;
				soundcard-mach,pll-fs = <0x01>;
				phandle = <0x58>;
			};

			i2s0_codec: soundcard-mach,codec {
				phandle = <0xb6>;
			};
		};

		soc_pmu0: soc_pmu0@4A000800 {
			compatible = "sunxi-soc-pmu,V821";
			device_type = "sunxi-soc-pmu";
			status = "okay";
			reg = <0x00 0x4a000800 0x00 0x94>;
			phandle = <0xb7>;

			pmu_soc_ldo1: ldo1 {
				regulator-name = "ldo1";
				regulator-min-microvolt = <0x225510>;
				regulator-max-microvolt = <0x2dc6c0>;
				regulator-enable-ramp-delay = <0x3e8>;
				phandle = <0xb8>;
			};
		};

		lcd_fb: lcd_fb {
			compatible = "allwinner,lcd-fb";
			status = "disabled";
			phandle = <0xb9>;
		};

		xrbt_smd: xrbt_smd {
			compatible = "allwinner,xradio_bt_smd";
			status = "disabled";
			phandle = <0xba>;
		};

		wakeup_io: wakeup_io {
			compatible = "allwinner,sunxi_wupio";
			gprcm_reg = <0x00 0x4a000000 0x00 0x20>;
			interrupts-extended = <0x07 0xab 0x04>;
			wakeup-source;
			status = "disabled";
			phandle = <0xbb>;

			wakeup_pins {

				wakeup_pin1: wakeup-pin@1 {
					phandle = <0xbc>;
				};
			};
		};

		card0_boot_para@0 {
			device_type = "card0_boot_para";
			card_ctrl = <0x00>;
			card_high_speed = <0x01>;
			card_line = <0x04>;
			pinctrl-0 = <0x5a>;
			clk_type = "typ1";
		};

		usb_power_supply: usb_power_supply {
			compatible = "sunxi-gpio-vbus-supply";
			status = "okay";
			usb_det_gpio = <0x55 0x00 0x03 0x01>;
			phandle = <0x2f>;
		};

		addr_mgt: addr_mgt {
			compatible = "allwinner,sunxi-addr_mgt";
			type_addr_wifi = <0x00>;
			type_addr_bt = <0x00>;
			type_addr_eth = <0x00>;
			status = "okay";
			phandle = <0xbd>;
		};
	};

	poweron-source {
		hib_poweron_source = <0x7ff>;
		ultra_poweron_source = <0x7ff>;
	};

	hifbypass: hifbypass {
		compatible = "allwinner,sun300wi-sip-wifi";
		status = "disabled";
		phandle = <0xbe>;
	};

	rpbuf_controller0: rpbuf_controller0@0 {
		compatible = "allwinner,rpbuf-controller";
		status = "disabled";
		phandle = <0xbf>;
	};

	rpbuf_xradio: rpbuf_xradio@0 {
		compatible = "allwinner,rpbuf-xradio";
		status = "disabled";
		phandle = <0xc0>;
	};

	heap_size_pool@0 {
		status = "disabled";
	};

	ly_dev: ly_dev {
		compatible = "ly,dev";
		wifi_en_gpio = <0x0d 0x03 0x0b 0x01 0x00 0x01 0x01>;
		wifi_en2_gpio = <0x0d 0x03 0x11 0x01 0x00 0x01 0x01>;
		key_gpio = <0x0d 0x02 0x10 0x01 0x00 0x01 0x00>;
		led_gpio0 = <0x0d 0x02 0x02 0x01 0x00 0x01 0x00>;
		led_gpio1 = <0x0d 0x02 0x01 0x01 0x00 0x01 0x00>;
		led_gpio2 = <0x0d 0x02 0x00 0x01 0x00 0x01 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x5b>;
		status = "ok";
		phandle = <0xc1>;
	};

	rfkill: rfkill {
		compatible = "allwinner,sunxi-rfkill";
		status = "okay";

		wlan {
			compatible = "allwinner,sunxi-wlan";
			wlan_busnum = <0x01>;
		};
	};

	ly_matrix_led: ly_matrix_led {
		compatible = "ly,matrix_led";
		hcd_stb_gpio = <0x0d 0x03 0x0e 0x01 0x00 0x01 0x01>;
		hcd_clk_gpio = <0x0d 0x03 0x0f 0x01 0x00 0x01 0x01>;
		hcd_dio_gpio = <0x0d 0x03 0x10 0x01 0x00 0x01 0x01>;
		status = "ok";
		phandle = <0xc2>;
	};

	axp2202_parameter: axp2202-parameter {
		select = "battery-model";
		phandle = <0x2e>;

		battery-model {
			parameter = <0x1f50000 0xfb0000fb 0x1e3202 0x14050a04 0x74fdbc0c 0xdf10ccfb 0x8000dc18 0xe406cc06 0x940b4f0f 0xcf0f6d0a 0x50ecb0e 0xc804bb04 0xaa09980e 0x790e6709 0x620e080c 0x3e020c01 0xda06a80b 0x710b4406 0x12723c33 0x27141a0e>;
		};
	};

