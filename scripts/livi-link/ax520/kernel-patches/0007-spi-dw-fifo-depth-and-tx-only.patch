 	return 0;
 }
 
+static int dw_spi_tx_only(struct dw_spi *dws)
+{
+	unsigned long flags;
+	int guard = 200000;
+
+	/* Short frames only: interrupts are off, so nothing can leave a gap in the bit stream. */
+	local_irq_save(flags);
+	while (dws->tx_len) {
+		u32 room = dws->fifo_len - dw_readl(dws, DW_SPI_TXFLR);
+
+		while (room && dws->tx_len) {
+			u32 txw;
+
+			if (dws->n_bytes == 1)
+				txw = *(u8 *)(dws->tx);
+			else if (dws->n_bytes == 2)
+				txw = *(u16 *)(dws->tx);
+			else
+				txw = *(u32 *)(dws->tx);
+			dw_write_io_reg(dws, DW_SPI_DR, txw);
+			dws->tx += dws->n_bytes;
+			dws->tx_len--;
+			room--;
+		}
+	}
+	while (guard-- &&
+	       ((dw_readl(dws, DW_SPI_SR) & DW_SPI_SR_BUSY) || !(dw_readl(dws, DW_SPI_SR) & DW_SPI_SR_TF_EMPT)))
+		cpu_relax();
+	local_irq_restore(flags);
+
+	return guard < 0 ? -ETIMEDOUT : 0;
+}
