# Minimal hostapd build config for LIVI-Link AP (WPA2-PSK, nl80211, libnl3).
# Internal TLS/crypto so we do not need to cross-build OpenSSL — WPA2-PSK
# does not use TLS, only AES + SHA1/SHA256 which the internal crypto ships.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_ACS=y
CONFIG_CTRL_IFACE=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_CRYPTO=internal
