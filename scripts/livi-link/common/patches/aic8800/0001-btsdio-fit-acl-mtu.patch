+
+static void btsdio_fit_acl_mtu(struct sk_buff *skb)
+{
+	u8 *ev = skb->data;
+
+	if (skb->len < 8 || ev[0] != HCI_EV_CMD_COMPLETE || ev[5])
+		return;
+	if (get_unaligned_le16(ev + 3) != HCI_OP_READ_BUFFER_SIZE)
+		return;
+	if (get_unaligned_le16(ev + 6) > BT_ACL_MTU_MAX)
+		put_unaligned_le16(BT_ACL_MTU_MAX, ev + 6);
 }
 
