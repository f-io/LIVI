+static int rwnx_cfg80211_get_key_wdev(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id,
+				      u8 key_index, bool pairwise, const u8 *mac_addr, void *cookie,
+				      void (*callback)(void *cookie, struct key_params *))
+{
+	return rwnx_cfg80211_get_key(wiphy, wdev->netdev, link_id, key_index, pairwise, mac_addr,
+				     cookie, callback);
+}
+
+static int rwnx_cfg80211_del_key_wdev(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id,
+				      u8 key_index, bool pairwise, const u8 *mac_addr)
