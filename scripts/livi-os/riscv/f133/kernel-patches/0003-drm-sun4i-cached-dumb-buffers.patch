The DE2 mixer scans out buffers the CPU fills with a software renderer, which reads back every pixel
it blends. Mapped write-combined, each of those reads and stores goes to DRAM one by one. Cached and
written back once per commit, as ingenic-drm does, they cost no more than any other memory.
Only the sun8i mixer layers write back, which is all the F133 has.

diff -ru a/drivers/gpu/drm/sun4i/sun4i_drv.c b/drivers/gpu/drm/sun4i/sun4i_drv.c
--- a/drivers/gpu/drm/sun4i/sun4i_drv.c
+++ b/drivers/gpu/drm/sun4i/sun4i_drv.c
@@ -42,6 +42,23 @@
 	return drm_gem_dma_dumb_create_internal(file_priv, drm, args);
 }
 
+/*
+ * Buffers the CPU draws into are mapped cached and written back on commit: a software renderer
+ * reads back what it blends, which is slow through an uncached mapping.
+ */
+static struct drm_gem_object *sun4i_drv_gem_create_object(struct drm_device *drm, size_t size)
+{
+	struct drm_gem_dma_object *obj;
+
+	obj = kzalloc_obj(*obj);
+	if (!obj)
+		return ERR_PTR(-ENOMEM);
+
+	obj->map_noncoherent = true;
+
+	return &obj->base;
+}
+
 DEFINE_DRM_GEM_DMA_FOPS(sun4i_drv_fops);
 
 static const struct drm_driver sun4i_drv_driver = {
@@ -56,6 +73,7 @@
 
 	/* GEM Operations */
 	DRM_GEM_DMA_DRIVER_OPS_WITH_DUMB_CREATE(drm_sun4i_gem_dumb_create),
+	.gem_create_object	= sun4i_drv_gem_create_object,
 	DRM_FBDEV_DMA_DRIVER_OPS,
 };
 
