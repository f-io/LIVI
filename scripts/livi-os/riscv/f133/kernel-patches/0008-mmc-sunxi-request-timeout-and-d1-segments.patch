+/*
+ * The controller's own timeout is off (REG_TMOUT all ones), so a request whose done or error
+ * interrupt is lost would hold the host forever. Allwinner's driver ends such a request after 5 s
+ * as well (SUNXI_SC_EN_TIMEOUT_DETECT).
+ */
+#define SUNXI_MMC_REQUEST_TIMEOUT_MS	5000
+
+static void sunxi_mmc_timeout(struct work_struct *work)
+{
+	struct sunxi_mmc_host *host = container_of(to_delayed_work(work),
+						   struct sunxi_mmc_host, timeout_work);
+	struct mmc_request *mrq;
+	unsigned long iflags;
+	bool stop;
+
+	spin_lock_irqsave(&host->lock, iflags);
+	mrq = host->mrq;
+	if (!mrq) {
+		spin_unlock_irqrestore(&host->lock, iflags);
+		return;
+	}
+	dev_err(mmc_dev(host->mmc),
+		"cmd %d arg %x got no interrupt: int_sum %08x mista %08x idst %08x status %08x\n",
+		mrq->cmd->opcode, mrq->cmd->arg, host->int_sum,
+		mmc_readl(host, REG_MISTA), mmc_readl(host, REG_IDST),
+		mmc_readl(host, REG_STAS));
+	host->int_sum |= SDXC_DATA_TIMEOUT;
+	stop = sunxi_mmc_finalize_request(host) == IRQ_WAKE_THREAD;
+	spin_unlock_irqrestore(&host->lock, iflags);
+
+	if (stop) {
+		sunxi_mmc_send_manual_stop(host, mrq);
+		spin_lock_irqsave(&host->lock, iflags);
+		host->manual_stop_mrq = NULL;
+		spin_unlock_irqrestore(&host->lock, iflags);
+	}
+	mmc_request_done(host->mmc, mrq);
+}
