@@ -75,9 +75,15 @@ __weak void mmu_enable(u32 dram_size)
 #endif
 }
 
+/* The images were written through the write-back D-cache, the next stage fetches them from DRAM. */
 __weak void mmu_disable(void)
 {
-
+#ifdef CFG_USE_DCACHE
+	asm volatile(".long 0x0030000b\n"	/* dcache.ciall */
+		     ".long 0x0100000b\n"	/* icache.iall */
+		     ".long 0x01b0000b\n"	/* sync.is */
+		     "fence.i" ::: "memory");
+#endif
 }
 
 void data_sync_barrier(void)
