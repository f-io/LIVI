diff --git a/drivers/dram/sun20iw1p1/lib-dram/Makefile b/drivers/dram/sun20iw1p1/lib-dram/Makefile
index c8e1c7e..f3797dc 100644
--- a/drivers/dram/sun20iw1p1/lib-dram/Makefile
+++ b/drivers/dram/sun20iw1p1/lib-dram/Makefile
@@ -45,6 +45,15 @@ $(LIB):	$(obj).depend $(OBJS)
 #########################################################################
 
 # defines $(obj).depend target
+# The decompiled mctl_hal.c waits through sdelay(), an empty stub here. The shipped compiler output is
+# the vendor HAL with real delays, the same xfel uses for its F133 DRAM init.
+# t-head-compat.inc turns the register names into numbers, current gas then makes "or a5,a5,a3" an
+# "ori a5,a5,13". Binutils knows these T-Head instructions as th.*, with the same operands.
+$(obj)mctl_hal.o: mctl_hal.S_shipped
+	sed -E -e "/t-head-compat.inc/d" \
+	  -e "s/^(\s+)(extu|ldd|lrbu|lrw|lurw|lwd|sdd|srb|srw|swia)(\s)/\1th.\2\3/" $< > $(obj)mctl_hal_th.S
+	$(Q)$(CC) $(ALL_AFLAGS) -march=rv64gc_xtheadbb_xtheadmemidx_xtheadmempair -o $@ $(obj)mctl_hal_th.S -c
+
 include $(TOPDIR)/mk/rules.mk
 
 sinclude $(obj).depend
