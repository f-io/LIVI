-		goto _BOOT_ERROR;
 #ifdef CFG_SUNXI_PHY_KEY
-	} else if (check_update_key(&key_input)) {
+	if (check_update_key(&key_input))
 		goto _BOOT_ERROR;
 #endif
-	} else if (BT0_head.prvt_head.enable_jtag) {
+	if (BT0_head.prvt_head.enable_jtag) {
 		printf("enable_jtag\n");
 		boot_set_gpio((normal_gpio_cfg *)BT0_head.prvt_head.jtag_gpio, 5, 1);
 	}
 
+	/*
+	 * A boot that does not reach the rootfs ends in FEL: the rootfs clears rtc[3], the watchdog resets
+	 * after 16 s unless the kernel has taken it over.
+	 */
+	rtc_write_data(RTC_TRYING, TRYING);
+	writel(0x16aa0001, (void *)0x020500b4);
+	writel(0x16aa0000 | 0xb << 4 | 1, (void *)0x020500b8);
+
 #ifdef FPGA_PLATFORM
 	dram_size = mctl_init((void *)BT0_head.prvt_head.dram_para);
 #else
@@ -81,9 +101,7 @@ void main(void)
 		goto _BOOT_ERROR;
 
 	status = load_package();
-	if(status == 0 )
-		load_image(&uboot_base, &optee_base, &monitor_base, &rtos_base, &opensbi_base, &dtb_base);
-	else
+	if (status || load_image(&uboot_base, &optee_base, &monitor_base, &rtos_base, &opensbi_base, &dtb_base))
 		goto _BOOT_ERROR;
 
 	if (dtb_base) {
@@ -138,17 +156,9 @@ void main(void)
 
 	while(1);
 _BOOT_ERROR:
-	boot0_clear_env();
-	boot0_jmp(FEL_BASE);
-
-}
-
-static int boot0_clear_env(void)
-{
-	sunxi_board_exit();
-	sunxi_board_clock_reset();
-	mmu_disable();
-	mdelay(10);
-
-	return 0;
+	rtc_write_data(RTC_FEL, EFEX);
+	writel(0x16aa0001, (void *)0x020500b4);
+	writel(0x16aa0000 | 0 << 4 | 1, (void *)0x020500b8);
+	for (;;)
+		;
 }
diff --git a/nboot/main/load_image.c b/nboot/main/load_image.c
