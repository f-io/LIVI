 #endif
 
-static int boot0_clear_env(void);
+#define RTC_FEL 2
+#define EFEX 0x5AA5A55A
+#define RTC_TRYING 3
+#define TRYING 0x4c495659
 
 void main(void)
 {
@@ -27,6 +30,18 @@ void main(void)
 	phys_addr_t  uboot_base = 0, optee_base = 0, monitor_base = 0, \
 				rtos_base = 0, opensbi_base = 0, dtb_base = 0;
 
+	/*
+	 * FEL is entered here, before the PLLs and caches are set up: the BROM USB code and the xfel
+	 * payloads expect that state, with CPU, AHB and APB on OSC24M. An error later on comes back
+	 * through a watchdog reset.
+	 */
+	if (rtc_read_data(RTC_FEL) == EFEX || rtc_read_data(RTC_TRYING) == TRYING) {
+		rtc_write_data(RTC_FEL, 0);
+		rtc_write_data(RTC_TRYING, 0);
+		sunxi_board_clock_reset();
+		boot0_jmp(FEL_BASE);
+	}
+
 	sunxi_serial_init(BT0_head.prvt_head.uart_port, (void *)BT0_head.prvt_head.uart_ctrl, 6);
 	printf("HELLO! BOOT0 is starting!\n");
 	printf("BOOT0 commit : %s\n", BT0_head.hash);
@@ -36,18 +51,23 @@ void main(void)
 	if(status)
 		goto _BOOT_ERROR;
 
-	if (rtc_probe_fel_flag()) {
