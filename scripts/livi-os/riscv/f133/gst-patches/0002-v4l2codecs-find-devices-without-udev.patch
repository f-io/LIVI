@@ -306,10 +307,50 @@ function_to_string (guint32 function)
   return "unknown";
 }
 
+/* Without udev the media and video nodes are found by name in /dev. */
+static GList *
+find_media_nodes (void)
+{
+  GList *paths = NULL;
+  DIR *dir = opendir ("/dev");
+  struct dirent *e;
+
+  if (!dir)
+    return NULL;
+  while ((e = readdir (dir)))
+    if (g_str_has_prefix (e->d_name, "media"))
+      paths = g_list_prepend (paths, g_strconcat ("/dev/", e->d_name, NULL));
+  closedir (dir);
+  return paths;
+}
+
+static gchar *
+find_char_node (dev_t devnum)
+{
+  gchar *found = NULL;
+  DIR *dir = opendir ("/dev");
+  struct dirent *e;
+  struct stat st;
+
+  if (!dir)
+    return NULL;
+  while (!found && (e = readdir (dir))) {
+    gchar *path;
+    if (!g_str_has_prefix (e->d_name, "video"))
+      continue;
+    path = g_strconcat ("/dev/", e->d_name, NULL);
+    if (stat (path, &st) == 0 && S_ISCHR (st.st_mode) && st.st_rdev == devnum)
+      found = path;
+    else
+      g_free (path);
+  }
+  closedir (dir);
+  return found;
+}
+
 GList *
 gst_v4l2_codec_find_devices (void)
 {
