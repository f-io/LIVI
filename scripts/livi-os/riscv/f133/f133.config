CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_SUNXI=y
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_MAE=y
CONFIG_ERRATA_THEAD_CMO=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_RISCV_SBI=y
# CONFIG_SMP is not set
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=14
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# Only the symbols the WiFi modules take stay exported.
CONFIG_TRIM_UNUSED_KSYMS=y
# CONFIG_IO_URING is not set
# CONFIG_AIO is not set
# CONFIG_NAMESPACES is not set
# CONFIG_COREDUMP is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# The C906 has vector 0.7, the kernel knows 1.0 only.
# CONFIG_RISCV_ISA_V is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_NET_RX_BUSY_POLL is not set
# CONFIG_NET_PTP_CLASSIFY is not set
# CONFIG_IPV6_SIT is not set
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
# alsa-lib's dmix keeps its ring in SysV shared memory.
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_OF=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUN20I_D1=y
CONFIG_COMMON_CLK=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN20I_D1_CCU=y
CONFIG_SUN20I_D1_R_CCU=y
CONFIG_SUN6I_RTC_CCU=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_SIFIVE_PLIC=y
CONFIG_SUN4I_TIMER=y
CONFIG_RISCV_TIMER=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SUNXI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_EXTCON=y
CONFIG_POWER_SUPPLY=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_USB_GADGET=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_DEVMEM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_CMA=y
# The USB gadget refills 32 KB RX buffers: without compaction a fragmented 55 MB OOM-kills LIVI
# with 10 MB free.
CONFIG_COMPACTION=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32
# Video and display buffers are about 1 MB, 1 MB alignment leaves no room between them.
CONFIG_CMA_ALIGNMENT=4
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_LIVI_HE0801A068=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_AW_G2D=y
CONFIG_G2D_RCQ=y
CONFIG_G2D_MIXER=y
CONFIG_G2D_ROTATE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_LIVI_HE0801A068=y
CONFIG_PM=y
CONFIG_EXPERT=y
# CONFIG_DEBUG_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VT is not set
# Idle process memory goes compressed into RAM instead of pushing out the code pages squashfs has
# to unpack again. lz4: cheap on the C906, which has time to spare, the RAM has none.
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_BRIDGE=y
# CONFIG_BRIDGE_IGMP_SNOOPING is not set
CONFIG_IPV6=y
# Wired phones: the kernel runs the iPhone's NCM, without a tap device livi takes its interface.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y
CONFIG_BLOCK=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
# The web update writes the rootfs it runs from.
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=y
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_SUN6I=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# LIVI's settings and pairings, a few KB: no compressors.
CONFIG_JFFS2_FS=y
# CONFIG_JFFS2_ZLIB is not set
# CONFIG_JFFS2_RTIME is not set
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=y
CONFIG_SRAM=y
# The internal codec: DAC to HPOUT (AB5301B AUX in), ADC from MICIN3. Its LDOs take the SID trim.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN20I_CODEC=y
CONFIG_NVMEM_SUNXI_SID=y
# CONFIG_SND_SUPPORT_OLD_API is not set
# CONFIG_SND_VERBOSE_PROCFS is not set
