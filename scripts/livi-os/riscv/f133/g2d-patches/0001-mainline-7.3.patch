The radxa BSP G2D (RCQ) driver on mainline 7.3: no AW_BSP menu, printk instead of sunxi-log, the
7.x class, ida, remove and namespace APIs, 64-bit RCQ addresses on any 64-bit arch, and no runtime PM.

diff -ruN a/Kconfig b/Kconfig
--- a/Kconfig
+++ b/Kconfig
@@ -1,7 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 
 menu "G2D Drivers"
-	depends on AW_BSP
 
 config AW_G2D
 	tristate "G2D Support for Allwinner SoCs"
diff -ruN a/g2d_rcq/g2d.c b/g2d_rcq/g2d.c
--- a/g2d_rcq/g2d.c
+++ b/g2d_rcq/g2d.c
@@ -29,6 +29,12 @@
 #include "linux/hwspinlock.h"
 #include "../g2d_buf_cache.h"
 
+/*
+ * The F133 G2D sits in no power domain. Runtime PM would gate its clocks and reinitialise the engine
+ * around every ioctl, open and release do it once instead.
+ */
+#undef CONFIG_PM_GENERIC_DOMAINS
+
 #if IS_ENABLED(CONFIG_PM_GENERIC_DOMAINS)
 #define PM_ARRAY_SIZE  8
 #endif
@@ -1575,7 +1581,7 @@
 	.mmap = g2d_mmap,
 };
 
-static int g2d_remove(struct platform_device *pdev)
+static void g2d_remove(struct platform_device *pdev)
 {
 #if (IS_ENABLED(CONFIG_G2D_USE_HWSPINLOCK) && !IS_ENABLED(CONFIG_PM_GENERIC_DOMAINS))
 	pm_runtime_put_sync(para.dev);
@@ -1599,7 +1605,6 @@
 	sysfs_remove_group(&g2d_dev->kobj, &g2d_attribute_group);
 
 	G2D_INFO("Driver unloaded succesfully\n");
-	return 0;
 }
 
 static int g2d_suspend(struct device *dev)
@@ -1692,11 +1697,7 @@
 		G2D_ERR("I was assigned major number %d\n", MAJOR(devid));
 		return -1;
 	}
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
 	g2d_class = class_create("g2d");
-#else
-	g2d_class = class_create(THIS_MODULE, "g2d");
-#endif
 	if (IS_ERR(g2d_class)) {
 		G2D_ERR("create class error\n");
 		return -1;
@@ -1738,4 +1739,4 @@
 MODULE_DESCRIPTION("g2d(rcq) driver");
 MODULE_VERSION("1.0.2");
 MODULE_LICENSE("GPL");
-MODULE_IMPORT_NS(DMA_BUF);
+MODULE_IMPORT_NS("DMA_BUF");
